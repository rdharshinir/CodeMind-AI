# ==========================================
# CodeMind AI - Environment Configuration
# ==========================================

# 1. Hindsight Memory (Vectorize) Configuration
# Get your API key from https://ui.hindsight.vectorize.io (Use promo code MEMHACK99 for $50 free credits)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=codemind-main-bank

# 2. LLM Provider Configuration
# Groq is recommended for fast inference & free tier (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional alternative LLM providers:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=your_gemini_api_key_here

# 3. Application Configuration
CODEMIND_HOST=127.0.0.1
CODEMIND_PORT=8000
CODEMIND_DEBUG=true
